{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "isolatedModules": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "lib": ["esnext", "dom"],
    "outDir": "../dist",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": [
    ".",
    "circu-types"
  ]
}
