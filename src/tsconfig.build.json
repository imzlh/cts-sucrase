{
  "compilerOptions": {
    "strict": true,
    "target": "es2020",
    "module": "commonjs",
    "isolatedModules": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "lib": ["es2020", "dom"],
    "outDir": "../dist",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": [
    "."
  ]
}
